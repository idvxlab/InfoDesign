{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tju-mas:contracts:review-report",
  "title": "ReviewReport",
  "description": "独立审查报告。绑定被审成果的确切版本与内容指纹，逐项列出检查结果、问题、依据、严重程度与建议回退阶段。报告只描述审查结论，不修改业务成果。",
  "type": "object",
  "required": [
    "protocolVersion",
    "reportId",
    "reportVersionId",
    "projectId",
    "taskId",
    "attemptId",
    "reviewMode",
    "subject",
    "verdict",
    "checks",
    "issues",
    "summary",
    "executionStatus",
    "reviewedBy",
    "createdAt"
  ],
  "properties": {
    "protocolVersion": { "$ref": "urn:tju-mas:contracts:common#/$defs/protocolVersion" },
    "reportId": { "$ref": "urn:tju-mas:contracts:common#/$defs/reportId" },
    "reportVersionId": { "$ref": "urn:tju-mas:contracts:common#/$defs/identifier" },
    "projectId": { "$ref": "urn:tju-mas:contracts:common#/$defs/projectId" },
    "taskId": { "$ref": "urn:tju-mas:contracts:common#/$defs/taskId" },
    "attemptId": { "$ref": "urn:tju-mas:contracts:common#/$defs/attemptId" },
    "reviewMode": { "$ref": "urn:tju-mas:contracts:common#/$defs/reviewMode" },
    "subject": { "$ref": "#/$defs/reportSubject" },
    "verdict": { "$ref": "urn:tju-mas:contracts:common#/$defs/reviewVerdict" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/checkResult" }
    },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" },
      "maxItems": 10000
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "executionStatus": { "enum": ["completed", "failed"] },
    "reviewedBy": { "$ref": "urn:tju-mas:contracts:common#/$defs/agentProvenance" },
    "createdAt": { "$ref": "urn:tju-mas:contracts:common#/$defs/timestamp" },
    "extensions": { "$ref": "urn:tju-mas:contracts:common#/$defs/extensionBag" }
  },
  "additionalProperties": false,
  "$defs": {
    "reportSubject": {
      "type": "object",
      "required": ["subjectType", "snapshotId", "snapshotVersionId", "contentHash"],
      "properties": {
        "subjectType": { "enum": ["evidence_snapshot"] },
        "snapshotId": { "$ref": "urn:tju-mas:contracts:common#/$defs/snapshotId" },
        "snapshotVersionId": { "$ref": "urn:tju-mas:contracts:common#/$defs/identifier" },
        "contentHash": { "$ref": "urn:tju-mas:contracts:common#/$defs/contentHash" }
      },
      "additionalProperties": false
    },
    "checkResult": {
      "type": "object",
      "required": ["checkId", "checkType", "status", "finding"],
      "properties": {
        "checkId": { "$ref": "urn:tju-mas:contracts:common#/$defs/identifier" },
        "checkType": { "$ref": "urn:tju-mas:contracts:common#/$defs/checkType" },
        "status": { "$ref": "urn:tju-mas:contracts:common#/$defs/checkStatus" },
        "claimRefs": {
          "type": "array",
          "items": { "$ref": "urn:tju-mas:contracts:common#/$defs/identifier" }
        },
        "evidenceRefs": {
          "type": "array",
          "items": { "$ref": "urn:tju-mas:contracts:common#/$defs/identifier" }
        },
        "finding": { "type": "string", "minLength": 1 },
        "severity": { "$ref": "urn:tju-mas:contracts:common#/$defs/severity" }
      },
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "required": ["issueId", "severity", "category", "description"],
      "properties": {
        "issueId": { "$ref": "urn:tju-mas:contracts:common#/$defs/identifier" },
        "claimId": { "$ref": "urn:tju-mas:contracts:common#/$defs/identifier" },
        "evidenceRefs": {
          "type": "array",
          "items": { "$ref": "urn:tju-mas:contracts:common#/$defs/identifier" }
        },
        "severity": { "$ref": "urn:tju-mas:contracts:common#/$defs/severity" },
        "category": { "$ref": "urn:tju-mas:contracts:common#/$defs/checkType" },
        "description": { "type": "string", "minLength": 1 },
        "expected": { "type": "string" },
        "actual": { "type": "string" },
        "suggestedStage": { "$ref": "urn:tju-mas:contracts:common#/$defs/suggestedStage" }
      },
      "additionalProperties": false
    }
  }
}