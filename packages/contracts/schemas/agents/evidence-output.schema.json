{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tju-mas:contracts:evidence-output",
  "title": "信息与证据 Agent输出",
  "description": "候选 EvidenceSnapshot、覆盖范围、缺失、冲突与停止原因。候选提交时快照及其每条事实的审查状态都必须为 pending；模型不能伪造已审查、已采纳或权限字段。",
  "type": "object",
  "required": [
    "protocolVersion",
    "taskId",
    "attemptId",
    "projectId",
    "status",
    "candidateSnapshot",
    "producedBy"
  ],
  "properties": {
    "protocolVersion": { "$ref": "urn:tju-mas:contracts:common#/$defs/protocolVersion" },
    "taskId": { "$ref": "urn:tju-mas:contracts:common#/$defs/taskId" },
    "attemptId": { "$ref": "urn:tju-mas:contracts:common#/$defs/attemptId" },
    "projectId": { "$ref": "urn:tju-mas:contracts:common#/$defs/projectId" },
    "status": { "$ref": "urn:tju-mas:contracts:common#/$defs/agentOutputStatus" },
    "candidateSnapshot": {
      "allOf": [
        { "$ref": "urn:tju-mas:contracts:evidence-snapshot" },
        {
          "type": "object",
          "properties": {
            "reviewStatus": { "const": "pending" },
            "claims": {
              "type": "array",
              "items": { "type": "object", "properties": { "reviewStatus": { "const": "pending" } } }
            },
            "producedBy": {
              "allOf": [
                { "$ref": "urn:tju-mas:contracts:common#/$defs/agentProvenance" },
                { "type": "object", "properties": { "role": { "const": "evidence" } } }
              ]
            }
          }
        }
      ]
    },
    "changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/claimChange" }
    },
    "stopReason": { "type": "string", "minLength": 1 },
    "producedBy": {
      "allOf": [
        { "$ref": "urn:tju-mas:contracts:common#/$defs/agentProvenance" },
        { "type": "object", "properties": { "role": { "const": "evidence" } } }
      ]
    },
    "extensions": { "$ref": "urn:tju-mas:contracts:common#/$defs/extensionBag" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["needs_information", "blocked", "failed"] } }, "required": ["status"] },
      "then": { "properties": { "stopReason": {} }, "required": ["stopReason"] }
    }
  ],
  "$defs": {
    "claimChange": {
      "type": "object",
      "required": ["changeId", "changeType", "claimId", "description"],
      "properties": {
        "changeId": { "$ref": "urn:tju-mas:contracts:common#/$defs/identifier" },
        "changeType": { "enum": ["added", "updated", "unchanged", "removed"] },
        "claimId": { "$ref": "urn:tju-mas:contracts:common#/$defs/identifier" },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
