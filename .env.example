# 本项目变量，不代表 Pi 官方环境变量；B2 已读取 APP_MODEL_*，其余业务服务变量仍待接入。
# 本文件仅作变量清单；B2 从容器环境注入，不自动加载 .env。不要提交密钥或放进前端变量。
APP_ENV=development
APP_API_HOST=127.0.0.1
APP_API_PORT=3001
APP_WEB_ORIGIN=http://localhost:5173
APP_PARSER_URL=http://127.0.0.1:8001
# 数据库与队列地址待实际部署后填写；此处不提供通用密码。
APP_DATABASE_URL=
APP_QUEUE_URL=
APP_STORAGE_DRIVER=local
APP_STORAGE_ROOT=./.local-data/storage
APP_SESSION_ROOT=./.local-data/sessions
# 以下由 B2 服务端 Pi 适配层显式读取、验证和映射，不自动加载 .env 文件。
APP_MODEL_API=openai-completions
APP_MODEL_PROVIDER=
APP_MODEL_ID=
APP_MODEL_BASE_URL=
APP_MODEL_API_KEY=
# 可选：按网关实际接口选择；使用 --models-file 时会读取所选模型／提供方 compat.maxTokensField。
# APP_MODEL_MAX_TOKENS_FIELD=max_tokens
# 可选的组件代码扩展分支默认不开启。
APP_ENABLE_COMPONENT_ENGINEERING=false

# 真实验收需用户明确授权；默认不调用模型。报告使用新路径，禁止覆盖已有记录。
APP_RUN_LIVE_EVAL=0
APP_B2_REPORT_PATH=
